rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Disallow all global reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can only access their own documents
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      
      // Enforce strict schema validation on creation
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['footprint', 'log', 'points', 'history'])
                    && request.resource.data.footprint.keys().hasAll(['travel', 'home', 'diet', 'consumption']);
    }
  }
}
